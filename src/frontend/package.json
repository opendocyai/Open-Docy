{
  "name": "@docyai/agent-kit",
  "private": false,
  "version": "0.1.2",
  "description": "Visual AI agent orchestration kit for Vue 3: a flow-editor canvas plus ready-made agent nodes (content generation, knowledge, web search, compliance) you can embed in any host app",
  "license": "MIT",
  "keywords": [
    "vue3",
    "ai",
    "agent",
    "agent-kit",
    "workflow",
    "visual-editor",
    "flow-editor",
    "node-editor",
    "orchestration"
  ],
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "third-party"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc -b",
    "build": "pnpm typecheck && vite build",
    "build:lib": "pnpm typecheck && BUILD_MODE=lib vite build",
    "copy:dist": "node scripts/copy-dist.mjs",
    "build:lib:copy": "pnpm build:lib:local && pnpm copy:dist",
    "copy:lib": "node scripts/copy-lib.mjs",
    "obfuscate:lib": "node scripts/obfuscate-lib.mjs",
    "build:lib:rete": "BUILD_MODE=lib-rete vite build",
    "build:lib:local": "pnpm build:lib && pnpm build:lib:rete && pnpm obfuscate:lib && pnpm copy:lib",
    "preview": "vite preview",
    "preview:web": "vite preview --outDir dist-web",
    "gen:components": "node scripts/generate-components-index.js",
    "gen:index": "node scripts/generate-index.js",
    "gen": "npm run gen:components && npm run gen:index",
    "lint": "eslint src"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "ant-design-vue": "^4.2.6",
    "dexie": "^4.4.6",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.4.0",
    "vue-router": "^5.2.0"
  },
  "dependencies": {
    "await-to-js": "^3.0.0",
    "codemirror": "^6.0.2"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@better-scroll/core": "^2.5.1",
    "@better-scroll/mouse-wheel": "^2.5.1",
    "@better-scroll/observe-dom": "^2.5.1",
    "@better-scroll/observe-image": "^2.5.1",
    "@better-scroll/scroll-bar": "^2.5.1",
    "@better-scroll/slide": "^2.5.1",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@file-viewer/preset-all": "^3.3.0",
    "@file-viewer/vue3": "^3.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@splinetool/runtime": "^1.12.98",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/tsconfig": "^0.9.1",
    "@vueuse/core": "^14.4.0",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.20.0",
    "crypto-es": "^3.1.3",
    "dayjs": "^1.11.23",
    "dexie": "^4.4.6",
    "fast-glob": "^3.3.3",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "javascript-obfuscator": "5.9.0",
    "js-base64": "^3.9.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "nanoid": "^6.0.0",
    "pdfjs-dist": "^6.2.108",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass": "^1.102.0",
    "typescript": "~6.0.3",
    "unocss": "^66.7.5",
    "uuid": "^14.0.1",
    "vite": "^8.2.4",
    "vite-plugin-dts": "^5.0.3",
    "vue-json-pretty": "^2.6.0",
    "vue-tsc": "^3.3.11",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  }
}
