{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2024",
    "module": "ESNext",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable",
      "ESNext.Iterator"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "noEmit": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "@docyai/rete": [
        "./src/rete-entry.ts",
        "./lib/docyai-model/rete-entry.d.ts"
      ],
      "@docyai": [
        "./src/index.ts",
        "./lib/docyai-model/index.d.ts"
      ],
      "@/*": [
        "./src/*"
      ],
      "~/*": [
        "./src/*"
      ],
    },
    "allowArbitraryExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.jsx",
    "src/**/*.vue",
    "src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-web",
    "scripts"
  ]
}