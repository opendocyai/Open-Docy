# Copy this file to .env and fill in your own values.
# See docs/configuration.md for details.

# ---- Models ----
MODEL_DEFAULT=openai:gpt-5
MODEL_FALLBACK=
EMBEDDING_PROVIDER=openai
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# ---- External services ----
TAVILY_API_KEY=
# LANGSMITH_API_KEY=

# ---- Platform auth (built-in API key auth) ----
# Host: set to the same values as settings.ini [Security] api_key/secret_key.
# Docker: non-empty values override the auto-generated keys and are written
# into settings.ini [Security] api_key/secret_key; leave empty to keep the
# generated ones.
API_KEY=change-me  # settings.ini Security.api_key
SECRET_KEY=change-me # settings.ini Security.secret_key

# ---- Data directories (leave empty to use defaults) ----
DATA_DIR=
AI_DATA_DIR=
DOCY_NO_AI_WORKER=
